{
  "openapi": "3.1.0",
  "info": {
    "title": "Menu Design",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Read Health",
        "operationId": "platform.health.read",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Database non raggiungibile: corpo {\"status\":\"unavailable\"}",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "public"
        }
      }
    },
    "/api/v1/auth/google/start": {
      "post": {
        "summary": "Start Login",
        "operationId": "identity.google.start",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartResponse"
                }
              }
            }
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "anonymous"
        }
      }
    },
    "/api/v1/auth/google/callback": {
      "get": {
        "summary": "Google Callback",
        "description": "Il valore dichiarato serve solo al contratto: i parametri si leggono con `_single`.",
        "operationId": "identity.google.callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Error"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Ritorno alla SPA; l'esito si legge da `GET /session`."
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "public"
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "summary": "Read Session",
        "operationId": "identity.session.read",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AnonymousSession"
                    },
                    {
                      "$ref": "#/components/schemas/AuthenticatedSession"
                    }
                  ],
                  "title": "Response Identity.Session.Read"
                }
              }
            }
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "public"
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Logout",
        "operationId": "identity.session.logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "account",
          "pendingDeletion": "allowed"
        }
      }
    },
    "/api/v1/courses": {
      "get": {
        "summary": "List Courses",
        "operationId": "catalog.course.list",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoursePage"
                }
              }
            }
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "family",
          "roles": [
            "admin",
            "planner",
            "member"
          ]
        }
      }
    },
    "/api/v1/dishes": {
      "get": {
        "summary": "List Dishes",
        "operationId": "catalog.dish.list",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120,
              "description": "Nome, anche parziale",
              "default": "",
              "title": "Q"
            },
            "description": "Nome, anche parziale"
          },
          {
            "name": "courseId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Courseid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "to_try",
                    "tested"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "archived",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Archived"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DishPage"
                }
              }
            }
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "family",
          "roles": [
            "admin",
            "planner",
            "member"
          ]
        }
      },
      "post": {
        "summary": "Create Dish",
        "operationId": "catalog.dish.create",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DishWrite"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DishDetail"
                }
              }
            }
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "family",
          "roles": [
            "admin",
            "planner"
          ]
        }
      }
    },
    "/api/v1/dishes/{dishId}": {
      "get": {
        "summary": "Read Dish",
        "operationId": "catalog.dish.read",
        "parameters": [
          {
            "name": "dishId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Dishid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DishDetail"
                }
              }
            }
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "family",
          "roles": [
            "admin",
            "planner",
            "member"
          ]
        }
      },
      "put": {
        "summary": "Update Dish",
        "operationId": "catalog.dish.update",
        "parameters": [
          {
            "name": "dishId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Dishid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ETag \"<n>\"",
              "title": "If-Match"
            },
            "description": "ETag \"<n>\""
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DishUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DishDetail"
                }
              }
            }
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "family",
          "roles": [
            "admin",
            "planner"
          ]
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "displayName": {
            "type": "string",
            "title": "Displayname"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "displayName"
        ],
        "title": "AccountView"
      },
      "AnonymousSession": {
        "properties": {
          "authenticated": {
            "type": "boolean",
            "const": false,
            "title": "Authenticated"
          },
          "notices": {
            "items": {
              "$ref": "#/components/schemas/NoticeView"
            },
            "type": "array",
            "title": "Notices"
          },
          "authOutcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuthOutcomeView"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "authenticated",
          "notices"
        ],
        "title": "AnonymousSession"
      },
      "AuthOutcomeView": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "not_member",
              "auth_cancelled",
              "auth_failed",
              "reauth_wrong_account"
            ],
            "title": "Code"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "AuthOutcomeView"
      },
      "AuthenticatedSession": {
        "properties": {
          "authenticated": {
            "type": "boolean",
            "const": true,
            "title": "Authenticated"
          },
          "csrfToken": {
            "type": "string",
            "title": "Csrftoken"
          },
          "account": {
            "$ref": "#/components/schemas/AccountView"
          },
          "family": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FamilyView"
              },
              {
                "type": "null"
              }
            ]
          },
          "person": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PersonView"
              },
              {
                "type": "null"
              }
            ]
          },
          "privacyReviewRequired": {
            "type": "boolean",
            "title": "Privacyreviewrequired"
          },
          "notices": {
            "items": {
              "$ref": "#/components/schemas/NoticeView"
            },
            "type": "array",
            "title": "Notices"
          },
          "authOutcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuthOutcomeView"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "authenticated",
          "csrfToken",
          "account",
          "family",
          "person",
          "privacyReviewRequired",
          "notices"
        ],
        "title": "AuthenticatedSession"
      },
      "Course": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "baseCode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "starter",
                  "first",
                  "second",
                  "side",
                  "one_dish",
                  "dessert",
                  "drink",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Basecode"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "baseCode",
          "name"
        ],
        "title": "Course"
      },
      "CoursePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Course"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "CoursePage"
      },
      "DishDetail": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "to_try",
              "tested"
            ],
            "title": "Status"
          },
          "courseIds": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Courseids"
          },
          "prepTime": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "under_30",
                  "30_60",
                  "over_60"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Preptime"
          },
          "archived": {
            "type": "boolean",
            "title": "Archived"
          },
          "everPlanned": {
            "type": "boolean",
            "title": "Everplanned"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceView"
            },
            "type": "array",
            "title": "Sources"
          },
          "createdBy": {
            "type": "string",
            "format": "uuid",
            "title": "Createdby"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "courseIds",
          "archived",
          "everPlanned",
          "sources",
          "createdBy",
          "version"
        ],
        "title": "DishDetail"
      },
      "DishPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DishSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "title": "DishPage"
      },
      "DishSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "to_try",
              "tested"
            ],
            "title": "Status"
          },
          "courseIds": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Courseids"
          },
          "prepTime": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "under_30",
                  "30_60",
                  "over_60"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Preptime"
          },
          "archived": {
            "type": "boolean",
            "title": "Archived"
          },
          "everPlanned": {
            "type": "boolean",
            "title": "Everplanned"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "courseIds",
          "archived",
          "everPlanned"
        ],
        "title": "DishSummary"
      },
      "DishUpdate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "title": "Name"
          },
          "courseIds": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Courseids"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "prepTime": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "under_30",
                  "30_60",
                  "over_60"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Preptime"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Sources",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "courseIds"
        ],
        "title": "DishUpdate",
        "description": "`PUT`: sostituzione completa della scheda; lo stato cambia con `POST /status` (SL-05)."
      },
      "DishWrite": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "title": "Name"
          },
          "courseIds": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Courseids"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "prepTime": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "under_30",
                  "30_60",
                  "over_60"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Preptime"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Sources",
            "default": []
          },
          "status": {
            "type": "string",
            "enum": [
              "to_try",
              "tested"
            ],
            "title": "Status",
            "default": "to_try"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "courseIds"
        ],
        "title": "DishWrite",
        "description": "`POST`: come `DishUpdate` più lo stato iniziale (default «da provare»)."
      },
