{
  "openapi": "3.1.0",
  "info": {
    "title": "Menu Design",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Read Health",
        "operationId": "platform.health.read",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Database non raggiungibile: corpo {\"status\":\"unavailable\"}",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "public"
        }
      }
    },
    "/api/v1/auth/google/start": {
      "post": {
        "summary": "Start Login",
        "operationId": "identity.google.start",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartResponse"
                }
              }
            }
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "anonymous"
        }
      }
    },
    "/api/v1/auth/google/callback": {
      "get": {
        "summary": "Google Callback",
        "description": "Il valore dichiarato serve solo al contratto: i parametri si leggono con `_single`.",
        "operationId": "identity.google.callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Error"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Ritorno alla SPA; l'esito si legge da `GET /session`."
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "public"
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "summary": "Read Session",
        "operationId": "identity.session.read",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AnonymousSession"
                    },
                    {
                      "$ref": "#/components/schemas/AuthenticatedSession"
                    }
                  ],
                  "title": "Response Identity.Session.Read"
                }
              }
            }
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "public"
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Logout",
        "operationId": "identity.session.logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "default": {
            "description": "Errore (RFC 9457, `code` di ADR-0010)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-authz": {
          "scope": "account",
          "pendingDeletion": "allowed"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "displayName": {
            "type": "string",
            "title": "Displayname"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "displayName"
        ],
        "title": "AccountView"
      },
      "AnonymousSession": {
        "properties": {
          "authenticated": {
            "type": "boolean",
            "const": false,
            "title": "Authenticated"
          },
          "notices": {
            "items": {
              "$ref": "#/components/schemas/NoticeView"
            },
            "type": "array",
            "title": "Notices"
          },
          "authOutcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuthOutcomeView"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "authenticated",
          "notices"
        ],
        "title": "AnonymousSession"
      },
      "AuthOutcomeView": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "not_member",
              "auth_cancelled",
              "auth_failed",
              "reauth_wrong_account"
            ],
            "title": "Code"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "AuthOutcomeView"
      },
      "AuthenticatedSession": {
        "properties": {
          "authenticated": {
            "type": "boolean",
            "const": true,
            "title": "Authenticated"
          },
          "csrfToken": {
            "type": "string",
            "title": "Csrftoken"
          },
          "account": {
            "$ref": "#/components/schemas/AccountView"
          },
          "family": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FamilyView"
              },
              {
                "type": "null"
              }
            ]
          },
          "person": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PersonView"
              },
              {
                "type": "null"
              }
            ]
          },
          "privacyReviewRequired": {
            "type": "boolean",
            "title": "Privacyreviewrequired"
          },
          "notices": {
            "items": {
              "$ref": "#/components/schemas/NoticeView"
            },
            "type": "array",
            "title": "Notices"
          },
          "authOutcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuthOutcomeView"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "authenticated",
          "csrfToken",
          "account",
          "family",
          "person",
          "privacyReviewRequired",
          "notices"
        ],
        "title": "AuthenticatedSession"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "validation",
          "not_found",
          "forbidden",
          "unauthenticated",
          "reauth_required",
          "reauth_wrong_account",
          "csrf_failed",
          "conflict",
          "precondition_required",
          "rate_limited",
          "payload_too_large",
          "family_pending_deletion",
          "invite_invalid",
          "code_invalid",
          "age_declaration_blocked",
          "already_in_family",
          "last_admin",
          "dish_already_planned",
          "dish_not_planned",
          "course_in_use",
          "quota_exceeded",
          "range_too_large",
          "course_not_allowed",
          "person_before_join",
          "unsupported_media_type",
          "internal"
        ],
        "title": "ErrorCode"
      },
      "FamilyView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "today": {
            "type": "string",
            "format": "date",
            "title": "Today"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "pending_deletion"
            ],
            "title": "Status"
          },
          "deletionDueAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deletiondueat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "timezone",
          "today",
          "status"
        ],
        "title": "FamilyView"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "code": {
            "$ref": "#/components/schemas/ValidationCode"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          }
        },
        "type": "object",
        "required": [
          "field",
          "code"
        ],
        "title": "FieldError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "LogoutRequest": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "LogoutRequest",
        "description": "Corpo `{}`."
      },
      "NoticeView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "const": "admin_recovered",
            "title": "Kind"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "createdAt"
        ],
        "title": "NoticeView",
        "description": "Avviso alla famiglia (SL-24). Sempre vuoto in SL-03a.\n\n`subjectPersonId` (piano §4.2) si aggiunge con SL-24: il test di contratto di SL-03a vieta\noggi ogni nome di proprietà che contenga \"subject\" (cerca il `sub` di Google), da precisare."
      },
      "PersonView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "planner",
              "member"
            ],
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "role"
        ],
        "title": "PersonView"
      },
      "ProblemDetails": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "ProblemDetails",
        "description": "Schema pubblicato in OpenAPI per ogni risposta d'errore."
      },
      "StartRequest": {
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "login",
              "reauth"
            ],
            "title": "Purpose"
          },
          "returnTo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Returnto"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "purpose"
        ],
        "title": "StartRequest"
      },
      "StartResponse": {
        "properties": {
          "redirectUrl": {
            "type": "string",
            "title": "Redirecturl"
          }
        },
        "type": "object",
        "required": [
          "redirectUrl"
        ],
        "title": "StartResponse"
      },
      "ValidationCode": {
        "type": "string",
        "enum": [
          "required",
          "string_too_long",
          "limit_reached",
          "url_invalid",
          "course_required",
          "guests_range",
          "priority_range",
          "date_invalid",
          "range_order",
          "duplicate_course",
          "invalid_value",
          "unknown_field",
          "dish_archived"
        ],
        "title": "ValidationCode",
        "description": "Insieme chiuso dei codici di `errors[].code` (piano §4.1)."
      }
    }
  }
}
