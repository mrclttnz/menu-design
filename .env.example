# Solo segnaposto. Copiare in .env (ignorato da git). Mai valori reali qui.
APP_ENV=dev
TRUSTED_PROXY_HOPS=0
# Obbligatoria: l'avvio fallisce senza. Ruolo menu_app. Forma: postgresql+psycopg://UTENTE:PASSWORD@HOST:5432/menu
# con query sslmode=verify-full (richiesto in ogni ambiente, A-13) e sslrootcert=<CA>; in locale db/dev-certs/ca.crt.
DATABASE_URL_APP=CHANGE_ME
# Ruolo menu_owner, stessa forma: solo migrazioni (alembic) e comando seed. Mai nel servizio web.
DATABASE_URL_OWNER=CHANGE_ME
# Solo job menu-console (ADR-0011): ruolo menu_console, stessa forma e sslmode=verify-full.
DATABASE_URL_CONSOLE=CHANGE_ME
# Comando seed (A-22): APP_ENV dev|staging, target esplicito e host in allow-list.
# SEED_TARGET=local
# SEED_ALLOWED_DB_HOSTS=localhost
# Accesso con Google (SL-03a). Client OAuth "Applicazione web" della console Google Cloud; l'URI di
# reindirizzamento autorizzato e' APP_BASE_URL + /api/v1/auth/google/callback. Obbligatori in staging e production.
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
# Emittente OIDC. Predefinito e unico valore ammesso in staging e production: https://accounts.google.com.
# In dev e test puo' essere il provider finto dei test (mai un valore reale qui).
OIDC_ISSUER=https://accounts.google.com
# Origine pubblica dell'app, senza percorso: https in staging e production (cookie __Host-, controllo di Origin).
APP_BASE_URL=http://localhost:8000
# Da SL-03b (segnaposto):
# SESSION_PEPPER=CHANGE_ME

# Cartella della build della SPA (web/dist); vuota = solo API. Se impostata deve contenere index.html.
WEB_DIST_DIR=
